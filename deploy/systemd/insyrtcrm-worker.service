[Unit]
Description=insyrtcrm Django-Q2 background worker
After=network.target insyrtcrm.service

[Service]
Type=simple
User=insyrtcrm
Group=insyrtcrm
WorkingDirectory=/opt/insyrtcrm/repo
EnvironmentFile=/etc/insyrtcrm/insyrtcrm.env
ExecStart=/opt/insyrtcrm/repo/.venv/bin/python manage.py qcluster
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
