[Unit]
Description=insyrtcrm Django-Q2 background worker
After=network.target insyrtcrm.service

[Service]
Type=simple
User=insyrtcrm
Group=insyrtcrm
WorkingDirectory=/srv/python/insyrtcrm
EnvironmentFile=/etc/insyrtcrm/insyrtcrm.env
ExecStart=/srv/python/insyrtcrm/.venv/bin/python manage.py qcluster
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
