# Copy this file to /etc/insyrtcrm/insyrtcrm.env and fill in all values.
# That file must be owned root:insyrtcrm with mode 0640.
# Never commit the real file.

DJANGO_SETTINGS_MODULE=insyrtcrm.settings.prod

# Django — generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Allowed hosts — space-separated list (django-environ parses as list)
ALLOWED_HOSTS=crm.example.com

# PostgreSQL
DB_NAME=insyrtcrm
DB_USER=insyrtcrm
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis (Django cache + Django-Q2 broker)
# db=0 is used by Django-Q2, db=1 by the cache backend
REDIS_URL=redis://localhost:6379/0
